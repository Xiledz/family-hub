{
  "name": "Family Hub",
  "short_name": "Family",
  "description": "Shared family calendar and household hub",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f1f3f7",
